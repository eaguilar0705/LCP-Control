{
  "name": "lcp-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @lcp/frontend --",
    "clean": "node scripts/dev/clean.mjs",
    "check": "npm run lint && npm run build",
    "build": "npm run typecheck --workspace @lcp/contracts && npm run build --workspace @lcp/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:accounting": "node --test scripts/tests/*.test.mjs",
    "test:business-import": "node --test scripts/tests/business-import.test.mjs && node scripts/tests/business-import.mjs",
    "test:browser:business-import": "node scripts/tests/browser-business-import.mjs",
    "test:browser:suppliers": "node scripts/tests/browser-supplier-autocomplete.mjs",
    "test:browser:images": "node scripts/tests/browser-product-images.mjs",
    "test:browser:usability": "node scripts/tests/browser-inventory-usability.mjs && node scripts/tests/browser-everyday-usability.mjs",
    "lint": "eslint .",
    "format": "prettier --write frontend shared scripts *.json *.js *.md",
    "preview": "npm run preview --workspace @lcp/frontend --",
    "test:database": "node scripts/tests/business-day.mjs && node scripts/tests/day-contingencies.mjs && node scripts/tests/workday-flow.mjs && node scripts/tests/catalog-access.mjs && node scripts/tests/database-accounting-audit.mjs && node scripts/tests/automatic-sales-journal.mjs && node scripts/tests/cost-import.mjs && node scripts/tests/delivery-data-audit.mjs && node scripts/tests/historical-cost-reconciliation.mjs && node scripts/tests/business-import.mjs && node scripts/tests/cashier-access.mjs && node scripts/tests/price-lists.mjs",
    "test:price-lists": "node --test scripts/tests/price-lists.test.mjs && node scripts/tests/price-lists.mjs",
    "test:browser:store": "node scripts/tests/browser-inventory-purchases.mjs && node scripts/tests/browser-price-lists.mjs && node scripts/tests/browser-cashier-access.mjs",
    "test:store": "node scripts/tests/extended-store-flow.mjs",
    "test:browser": "node scripts/tests/browser-system.mjs && node scripts/tests/browser-sales-journal.mjs",
    "test:browser:accounting": "node scripts/tests/browser-accounting.mjs",
    "test:contingencies": "node scripts/tests/browser-day-contingencies.mjs && node scripts/tests/browser-sale-contingencies.mjs && node scripts/tests/browser-payment-dates.mjs",
    "test:delivery": "node scripts/tests/browser-delivery-audit.mjs && node scripts/tests/browser-history-volume.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
