{
  "name": "lcp-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @lcp/frontend --",
    "clean": "node scripts/dev/clean.mjs",
    "check": "npm run lint && npm run build",
    "build": "npm run typecheck --workspace @lcp/contracts && npm run build --workspace @lcp/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:discounts": "node --test scripts/tests/discount-model.test.mjs && node scripts/tests/discounts-and-history.mjs",
    "test:accounting": "node --test scripts/tests/*.test.mjs",
    "test:shipping": "node --test scripts/tests/shipping-accounting.test.mjs && node scripts/tests/shipping-accounting.mjs && node scripts/tests/shipping-liability.mjs",
    "test:browser:shipping": "node scripts/tests/browser-shipping.mjs",
    "test:opening-journal": "node scripts/tests/opening-journal-correction.mjs",
    "test:trial-opening": "node scripts/tests/trial-opening-balances.mjs",
    "test:invoice-corrections": "node scripts/tests/invoice-corrections.mjs",
    "test:ledger-accounts": "node scripts/tests/ledger-accounts.mjs",
    "test:browser:ledger-accounts": "node scripts/tests/browser-ledger-accounts.mjs",
    "test:browser:invoice-corrections": "node scripts/tests/browser-invoice-corrections.mjs",
    "test:browser:opening-journal": "node scripts/tests/browser-opening-journal-correction.mjs",
    "test:storefront": "node scripts/tests/storefront.mjs && node scripts/tests/storefront-inventory.mjs && node scripts/tests/storefront-sales.mjs && node scripts/tests/storefront-featured.mjs && node scripts/tests/storefront-catalogs.mjs",
    "test:business-import": "node --test scripts/tests/business-import.test.mjs && node scripts/tests/business-import.mjs",
    "test:browser:business-import": "node scripts/tests/browser-business-import.mjs",
    "test:browser:suppliers": "node scripts/tests/browser-supplier-autocomplete.mjs",
    "test:browser:customers": "node scripts/tests/browser-customer-autocomplete.mjs",
    "test:cost-location-counts": "node scripts/tests/expected-inventory-count.mjs",
    "test:inventory-adjustments": "node scripts/tests/inventory-adjustments.mjs && node scripts/tests/expected-inventory-count.mjs",
    "test:inventory-adjustment-accounting": "node scripts/tests/inventory-adjustment-accounting.mjs && node --test scripts/tests/inventory-adjustment-reporting.test.mjs",
    "test:inventory-adjustment-voids": "node scripts/tests/inventory-adjustment-voids.mjs",
    "test:browser:inventory-adjustments": "node scripts/tests/browser-inventory-adjustments.mjs && node scripts/tests/browser-stock-controls.mjs",
    "test:browser:cost-location-counts": "node scripts/tests/browser-cost-location-counts.mjs",
    "test:browser:images": "node scripts/tests/browser-product-images.mjs",
    "test:browser:usability": "node scripts/tests/browser-inventory-usability.mjs && node scripts/tests/browser-everyday-usability.mjs",
    "lint": "eslint .",
    "format": "prettier --write frontend shared scripts *.json *.js *.md",
    "preview": "npm run preview --workspace @lcp/frontend --",
    "test:database": "node scripts/tests/business-day.mjs && node scripts/tests/day-contingencies.mjs && node scripts/tests/workday-flow.mjs && node scripts/tests/catalog-access.mjs && node scripts/tests/database-accounting-audit.mjs && node scripts/tests/automatic-sales-journal.mjs && node scripts/tests/cost-import.mjs && node scripts/tests/delivery-data-audit.mjs && node scripts/tests/historical-cost-reconciliation.mjs && node scripts/tests/business-import.mjs && node scripts/tests/cashier-access.mjs && node scripts/tests/price-lists.mjs && node scripts/tests/inventory-transfers.mjs",
    "test:price-lists": "node --test scripts/tests/price-lists.test.mjs && node scripts/tests/price-lists.mjs",
    "test:browser:store": "node scripts/tests/browser-inventory-purchases.mjs && node scripts/tests/browser-price-lists.mjs && node scripts/tests/browser-cashier-access.mjs",
    "test:store": "node scripts/tests/extended-store-flow.mjs",
    "test:enterprise": "node scripts/tests/enterprise-integrity.mjs && node scripts/tests/enterprise-year-flow.mjs",
    "test:enterprise:pdf": "node scripts/tests/enterprise-document-pdf.mjs",
    "test:financial-corrections": "node scripts/tests/inventory-value.mjs && node scripts/tests/sales-returns-and-split.mjs && node scripts/tests/purchase-corrections.mjs && node scripts/tests/recovery-pagination.mjs",
    "test:browser:financial-corrections": "node scripts/tests/browser-inventory-valuation.mjs && node scripts/tests/browser-sales-returns-and-split.mjs && node scripts/tests/browser-purchase-corrections.mjs && node scripts/tests/browser-recovery-navigation.mjs",
    "test:browser:enterprise": "node scripts/tests/browser-first-use-audit.mjs && node scripts/tests/browser-journal-contingencies.mjs && node scripts/tests/browser-movement-confirmation.mjs && node scripts/tests/browser-operation-confirmation.mjs && node scripts/tests/browser-price-tier-confirmation.mjs && node scripts/tests/browser-master-data-concurrency.mjs && node scripts/tests/browser-inventory-transfers.mjs",
    "test:browser": "node scripts/tests/browser-system.mjs && node scripts/tests/browser-sales-journal.mjs",
    "test:browser:accounting": "node scripts/tests/browser-accounting.mjs",
    "test:business-day-opening": "node scripts/tests/business-day-opening.mjs && node scripts/tests/day-contingencies.mjs && node scripts/tests/business-day-correction.mjs && node scripts/tests/business-day-preparation.mjs",
    "test:browser:business-day": "node scripts/tests/browser-business-day-history.mjs && node scripts/tests/browser-business-day-correction.mjs && node scripts/tests/browser-business-day-preparation.mjs",
    "test:browser:daily-review": "node scripts/tests/browser-daily-review.mjs && node scripts/tests/browser-stock-controls.mjs",
    "test:contingencies": "node scripts/tests/browser-day-contingencies.mjs && node scripts/tests/browser-sale-contingencies.mjs && node scripts/tests/browser-payment-dates.mjs",
    "test:delivery": "node scripts/tests/browser-delivery-audit.mjs && node scripts/tests/browser-history-volume.mjs",
    "test:cash-corrections": "node scripts/tests/cash-and-account-corrections.mjs",
    "test:browser:cash-corrections": "node scripts/tests/browser-cash-and-account-corrections.mjs",
    "test:rounded-pricing": "node scripts/tests/rounded-pricing.mjs",
    "test:browser:rounded-pricing": "node scripts/tests/browser-rounded-pricing.mjs",
    "test:inventory-receipts": "node scripts/tests/inventory-receipts.mjs && node scripts/tests/inventory-receipts-integration.mjs",
    "test:browser:inventory-receipts": "node scripts/tests/browser-inventory-receipts.mjs",
    "test:purchase-accounting": "node scripts/tests/purchase-classification.mjs && node scripts/tests/fixed-inventory-purchase.mjs",
    "test:receipt-correction-netting": "node scripts/tests/receipt-correction-netting.mjs",
    "test:browser:receipt-correction-netting": "node scripts/tests/browser-receipt-correction-netting.mjs",
    "test:count-purchases": "node scripts/tests/count-purchase-adoption.mjs",
    "test:browser:count-purchases": "node scripts/tests/browser-count-purchase-adoption.mjs",
    "test:purchase-currency": "node --test scripts/tests/purchase-amounts.test.mjs && node scripts/tests/count-purchase-adoption.mjs",
    "test:browser:purchase-currency": "node scripts/tests/browser-purchase-currency.mjs",
    "test:browser:purchase-accounting": "node scripts/tests/browser-purchase-classification.mjs && node scripts/tests/browser-fixed-inventory-purchase.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
