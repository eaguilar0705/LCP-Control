{
  "name": "lcp-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @lcp/frontend --",
    "clean": "node scripts/dev/clean.mjs",
    "check": "npm run lint && npm run build",
    "build": "npm run typecheck --workspace @lcp/contracts && npm run build --workspace @lcp/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:accounting": "node --test scripts/tests/accounting.test.mjs scripts/tests/finance.test.mjs scripts/tests/journal.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write frontend shared scripts *.json *.js *.md",
    "preview": "npm run preview --workspace @lcp/frontend --",
    "test:database": "node scripts/tests/business-day.mjs && node scripts/tests/workday-flow.mjs && node scripts/tests/catalog-access.mjs",
    "test:browser": "node scripts/tests/browser-system.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
