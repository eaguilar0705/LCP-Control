# Solo URL del proyecto y clave publicable. Nunca service_role ni secret keys.
VITE_SUPABASE_URL=https://xkpujpoocsbkychstrne.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# supabase = catálogo, inventario y documentos reales (requiere sesión y rol).
# demo = catálogo local de sólo lectura, sin escrituras.
VITE_DATA_MODE=supabase
# Opcional: dirección pública a la que vuelven los enlaces de correo de Supabase
# (activación y cambio de correo). Por defecto, <origen actual>/auth/callback.
# Debe estar en Authentication → URL Configuration → Redirect URLs.
# VITE_AUTH_REDIRECT_URL=https://tu-dominio/auth/callback
